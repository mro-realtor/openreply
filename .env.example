# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Admin REST API (/api/v1) and MCP server (/api/mcp). Both are OFF unless "true".
API_V1_ENABLED=false
MCP_ENABLED=false
OAUTH_ENABLED=false
# Requests per minute allowed per API token (default 120).
API_RATE_LIMIT_PER_MINUTE=120

# Per-person DM dedup (milestone 2). Off by default.
CONTACTS_DEDUP_ENABLED=false
# Hours before any campaign may DM the same person again. 0 = off.
CONTACT_DM_COOLDOWN_HOURS=0

# Instagram connection upkeep (token renewal, webhook recovery). THIS CONTACTS META.
# Off unless the value is exactly "true". Leave false until you have approved it.
IG_MAINTENANCE_ENABLED=false
# How often the worker runs it when on, in milliseconds (default 6 hours, minimum 15 minutes;
# an invalid value falls back to the default).
IG_MAINTENANCE_INTERVAL_MS=21600000
