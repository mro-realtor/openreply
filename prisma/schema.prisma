// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
  assignedContacts  Contact[]         @relation("ContactAssignee")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  apiTokens         ApiToken[]

  @@index([ownerId])
  contacts          Contact[]
  webhookEndpoints  WebhookEndpoint[]
  outboxEvents      OutboxEvent[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Connection upkeep (see lib/instagram). Each account carries its own
  // authorization state; nothing here is shared between accounts or owners.
  connectionStatus     IgConnectionStatus @default(ACTIVE)
  needsReconnectReason String?
  /// OpenReply user who completed the Instagram login for this account.
  connectedByUserId    String?
  grantedScopes        String[]           @default([])
  lastRefreshAt        DateTime?
  nextRefreshAt        DateTime?
  refreshAttempts      Int                @default(0)
  lastRefreshError     String?
  refreshLockedUntil   DateTime?
  webhookCheckedAt     DateTime?
  webhookError         String?
  lastWebhookAt        DateTime?
  lastAlertKind        String?
  lastAlertAt          DateTime?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]

  @@index([workspaceId])
  @@index([connectionStatus])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  // True for campaigns created through the admin API / MCP that a human has
  // not yet reviewed and activated. A draft is always inactive. Every send
  // path already filters on isActive, so drafts never fire. Activating a
  // campaign from the dashboard clears this flag.
  isDraft        Boolean @default(false)
  // Settings captured by API/MCP drafts that no runtime feature reads yet
  // (conversation mode, lead capture fields, intended assignee). Inert until
  // the matching features exist.
  draftConfig    Json?
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  contactId     String?
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  contact          Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([automationId, commentId])
  @@index([contactId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

/// Machine credential for the admin REST API and MCP server. Only the SHA-256
/// hash of the secret is stored; the secret itself is shown once at creation.
model ApiToken {
  id              String    @id @default(cuid())
  workspaceId     String
  createdByUserId String?
  name            String
  /// First characters of the secret, kept so a token can be recognised in the UI.
  tokenPrefix     String
  tokenHash       String    @unique
  scopes          String[]
  expiresAt       DateTime
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  /// Set when the token was issued through OAuth. Revoking the grant revokes it.
  grantId         String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  idempotencyKeys IdempotencyKey[]

  @@index([workspaceId])
  @@index([grantId])
}

/// OAuth 2.1 client registered by Dynamic Client Registration (public client, PKCE).
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  name         String
  redirectUris String[]
  createdAt    DateTime @default(now())

  grants          OAuthGrant[]
  authorizationRequests OAuthAuthorizationRequest[]
}

/// A pending authorization the signed-in owner has not yet approved or denied.
/// The id is a random secret that only the browser redirected to the consent page knows.
model OAuthAuthorizationRequest {
  id            String    @id
  clientRefId   String
  userId        String
  redirectUri   String
  scopes        String[]
  state         String?
  codeChallenge String
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  client OAuthClient @relation(fields: [clientRefId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// What an owner approved: one client, one workspace, a set of scopes.
model OAuthGrant {
  id          String    @id @default(cuid())
  clientRefId String
  userId      String
  workspaceId String
  scopes      String[]
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  client        OAuthClient            @relation(fields: [clientRefId], references: [id], onDelete: Cascade)
  codes         OAuthAuthorizationCode[]
  refreshTokens OAuthRefreshToken[]

  @@index([workspaceId])
}

model OAuthAuthorizationCode {
  id            String    @id @default(cuid())
  codeHash      String    @unique
  grantId       String
  redirectUri   String
  codeChallenge String
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
}

model OAuthRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  grantId   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
}

/// Append-only record of API, MCP and token-management actions. No foreign
/// keys on purpose, so history survives token or workspace deletion.
model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String?
  apiTokenId   String?
  actorUserId  String?
  /// REST | MCP | DASHBOARD
  channel      String
  action       String
  targetType   String?
  targetId     String?
  /// SUCCESS | DENIED | ERROR
  outcome      String
  details      Json?
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([apiTokenId])
  @@index([action])
}

/// Replay protection for mutating API calls that carry an Idempotency-Key.
model IdempotencyKey {
  id             String   @id @default(cuid())
  apiTokenId     String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  apiToken ApiToken @relation(fields: [apiTokenId], references: [id], onDelete: Cascade)

  @@unique([apiTokenId, key])
  @@index([expiresAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}

enum SocialPlatform {
  INSTAGRAM
}

enum ContactStatus {
  ACTIVE
  OPTED_OUT
}

// One real person in a workspace, however many platform identities they have.
// Dedup, opt-out and human-takeover are decided per Contact, not per comment.
model Contact {
  id              String        @id @default(cuid())
  workspaceId     String
  displayName     String?
  status          ContactStatus @default(ACTIVE)
  optedOutAt      DateTime?
  humanTakeoverAt DateTime?
  /// Explicit permission to message this person. UNKNOWN until someone records it.
  consentStatus    ConsentStatus @default(UNKNOWN)
  consentUpdatedAt DateTime?
  consentSource    String?
  /// The teammate who owns follow up for this person.
  assignedToUserId String?
  assignedAt       DateTime?
  lastDmSentAt    DateTime?
  firstSeenAt     DateTime      @default(now())
  lastSeenAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo    User?                 @relation("ContactAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  identities    SocialIdentity[]
  dmLogs        DmLog[]
  consentEvents ContactConsentEvent[]

  @@index([workspaceId])
  @@index([workspaceId, assignedToUserId])
}

model SocialIdentity {
  id          String         @id @default(cuid())
  workspaceId String
  contactId   String
  platform    SocialPlatform
  externalId  String
  handle      String?
  createdAt   DateTime       @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, externalId])
  @@index([contactId])
}

enum IgConnectionStatus {
  ACTIVE
  DEGRADED
  NEEDS_RECONNECT
}

enum OutboundDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

/// A receiver (for example an n8n workflow or a CRM) that wants OpenReply events.
model WebhookEndpoint {
  id                  String    @id @default(cuid())
  workspaceId         String
  name                String
  url                 String
  secretEncrypted     String
  /// Empty means every event except ping.
  eventTypes          String[]  @default([])
  isActive            Boolean   @default(true)
  disabledReason      String?
  consecutiveFailures Int       @default(0)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

/// Something that happened, recorded once. dedupeKey makes emitting it twice harmless.
model OutboxEvent {
  id          String   @id @default(cuid())
  workspaceId String
  type        String
  payload     Json
  dedupeKey   String
  createdAt   DateTime @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
}

/// One attempt-tracked send of one event to one endpoint.
model WebhookDelivery {
  id             String                 @id @default(cuid())
  endpointId     String
  eventId        String
  status         OutboundDeliveryStatus @default(PENDING)
  attempts       Int                    @default(0)
  nextAttemptAt  DateTime               @default(now())
  lockedUntil    DateTime?
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event    OutboxEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  WITHDRAWN
}

/// Append-only history of consent decisions: what changed, when, where it came from, and who recorded it.
model ContactConsentEvent {
  id               String        @id @default(cuid())
  workspaceId      String
  contactId        String
  status           ConsentStatus
  source           String
  note             String?
  recordedByUserId String?
  createdAt        DateTime      @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([workspaceId])
}
